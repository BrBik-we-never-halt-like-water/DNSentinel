# ── DNSentinel configuration ───────────────────────────────────
# Copy to .env (or set in your deploy environment). All values are optional;
# sensible defaults apply and email runs in console mode if SMTP is unset.

# Server
PORT=3000
NODE_ENV=production

# Docker host port published by docker-compose — the port your reverse proxy targets.
# The container always listens on PORT (3000) internally; this only changes the host
# side. Set it when the VM already runs another app on 3000 (defaults to 3000).
# DNS_HOST_PORT=3002

# Public base URL used to build magic-link sign-in URLs and alert links.
# Defaults to the request's own host if unset.
APP_URL=https://dns.brbik.com

# Allowed browser origins (comma-separated). Defaults include localhost + dns.brbik.com.
# CORS_ORIGINS=https://dns.brbik.com,https://example.com

# SQLite database file location (mount a volume here in Docker).
DB_PATH=/app/data/dnsentinel.db

# ── Email (Resend HTTP API) ──
# If RESEND_API_KEY is unset, sign-in links and alerts are logged to the server
# console instead of being emailed (handy for local development).
# RESEND_FROM's domain must be verified in Resend (adds DKIM/SPF DNS records).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=DNSentinel <no-reply@dns.brbik.com>

# Alert checks interval in milliseconds (default 30 min).
# ALERT_INTERVAL_MS=1800000

# Response cache TTL in milliseconds (default 5 min).
# CACHE_TTL_MS=300000
